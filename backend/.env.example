# Optional: enables hosted AI summaries and replies. Without it InboxOps uses the local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Preferred hosted provider. Gemini free-tier requests may be used by Google to
# improve products; only selected emails are submitted after an explicit click.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Local OAuth callback. Production must use HTTPS.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# Production hardening. Keep disabled during localhost development.
INBOXOPS_ENV=development
INBOXOPS_REQUIRE_AUTH=false
SESSION_COOKIE_SECURE=false
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_SECONDS=300
SYNC_MESSAGE_LIMIT=50
AUTO_CLASSIFY=true
GMAIL_PUBSUB_TOPIC=
